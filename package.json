{
  "name": "christopher-tapia-portfolio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@12.8.1",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && svelte-check && astro build && pagefind --site dist && tsx scripts/generate-cv-pdf.ts",
    "preview": "astro preview",
    "check": "astro check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test",
    "pdf": "tsx scripts/generate-cv-pdf.ts",
    "check:cv": "tsx scripts/check-cv-pdf.ts",
    "check:seo": "node scripts/check-seo.mjs",
    "check:claims": "node scripts/check-claims.mjs",
    "check:tokens": "node scripts/check-tokens.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:primitives": "node scripts/check-primitives.mjs",
    "check:audio": "node scripts/check-audio.mjs",
    "check:paint": "node scripts/check-paint.mjs",
    "check:g1": "node scripts/check-tokens.mjs && node scripts/check-contrast.mjs && node scripts/check-primitives.mjs",
    "check:g3": "node scripts/check-audio.mjs && node scripts/check-paint.mjs",
    "check:g4": "node scripts/check-claims.mjs && node scripts/check-seo.mjs && tsx scripts/check-cv-pdf.ts",
    "check:heartbeat": "node scripts/check-heartbeat.mjs",
    "check:contact": "node scripts/check-contact.mjs"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.6",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.5",
    "@astrojs/svelte": "^9.1.6",
    "@tailwindcss/vite": "^4.3.5",
    "@tryghost/content-api": "^1.12.15",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.4.12",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sanitize-html": "2.18.2",
    "sharp": "0.35.5",
    "svelte": "^5.57.3",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "three": "0.170.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
    "@lhci/cli": "^0.16.1",
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "2.16.2",
    "@types/tryghost__content-api": "^1.3.17",
    "eslint": "^10.15.0",
    "eslint-plugin-astro": "^3.2.1",
    "pagefind": "1.6.0",
    "playwright": "^1.65.1",
    "schema-dts": "^2.1.0",
    "svelte-check": "^4.7.8",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  }
}
