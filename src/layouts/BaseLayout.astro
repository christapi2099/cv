---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SoundToggle from '../components/features/SoundToggle.astro';
import ThemeToggle from '../components/features/ThemeToggle.astro';
import { BUILD_ID } from '../lib/build-id';
import {
  buildOpenGraph,
  buildTwitter,
  canonicalUrl,
  serializeJsonLd,
  type OpenGraphType,
} from '../lib/seo';
import { feedLinkTags } from '../lib/series';

interface Props {
  title: string;
  description: string;
  seriesSlug?: string;
  /** Adds `robots: noindex, nofollow` (404, review routes). */
  noindex?: boolean;
  ogType?: OpenGraphType;
  ogImage?: string;
  ogImageAlt?: string;
  /** Page-specific JSON-LD, rendered in `<head>` via the safe serializer. */
  jsonLd?: readonly unknown[];
}

const {
  title,
  description,
  seriesSlug,
  noindex = false,
  ogType = 'website',
  ogImage,
  ogImageAlt,
  jsonLd = [],
} = Astro.props;

/*
 * One canonical helper, one site origin (plan §3). `Astro.url.pathname` is the
 * route the build emitted, so `/work/` and `/work` cannot disagree.
 */
const canonical = canonicalUrl(Astro.url.pathname);
const ogTags = buildOpenGraph({
  title,
  description,
  path: Astro.url.pathname,
  type: ogType,
  image: ogImage,
  imageAlt: ogImageAlt,
});
const twitterTags = buildTwitter({
  title,
  description,
  image: ogImage,
  imageAlt: ogImageAlt,
});

const NAV_ITEMS = [
  { label: 'Home', href: '/' },
  { label: 'Work', href: '/work' },
  { label: 'Blog', href: '/blog' },
  { label: 'About', href: '/about' },
  { label: 'CV', href: '/cv' },
  { label: 'Contact', href: '/contact' },
] as const;

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string): boolean =>
  href === '/' ? currentPath === '/' : currentPath === href || currentPath.startsWith(`${href}/`);

/*
 * Wordmark contract (plan §3): the wormhole canvas draws this string. The
 * element wraps it at 32 characters; fail the build rather than silently
 * overflowing at runtime.
 */
const LOGO_TEXT = 'CHRISTOPHER TAPIA';
const LOGO_TEXT_MAX = 32;
if (LOGO_TEXT.length > LOGO_TEXT_MAX) {
  throw new Error(
    `wormhole logo-text is ${LOGO_TEXT.length} chars; the vendor pin allows ${LOGO_TEXT_MAX}.`,
  );
}
---

<!doctype html>
<html class="dark" lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark light" />
    <meta name="build-id" content={BUILD_ID} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {ogTags.map((tag) =>
      tag.property ? (
        <meta property={tag.property} content={tag.content} />
      ) : (
        <meta name={tag.name} content={tag.content} />
      ),
    )}
    {twitterTags.map((tag) => (
      <meta name={tag.name} content={tag.content} />
    ))}
    {jsonLd.map((schema) => (
      <script type="application/ld+json" is:inline set:html={serializeJsonLd(schema)} />
    ))}
    <!--
      Vercel Web Analytics (docs: @vercel/analytics/astro). Render only in the
      production bundle so `astro dev` stays a no-op; the component injects a
      same-origin script and is inert with JavaScript disabled.
    -->
    {import.meta.env.PROD && <Analytics mode="production" />}
    {feedLinkTags(seriesSlug).map((tag) => (
      <link rel={tag.rel} type={tag.type} title={tag.title} href={tag.href} />
    ))}
    <!-- Pages inject canonical/OG/Twitter/JSON-LD/extra head tags here. -->
    <slot name="head" />
    <!--
      Michroma 400 is the display face the wormhole draws into its title
      canvas and the hero name renders in; preload the one face that exists
      (plan §1: self-hosted woff2, no synthetic bold). `no-font-link` below
      stops the vendored element from injecting a Google Fonts stylesheet.
    -->
    <link
      rel="preload"
      href="/fonts/michroma-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <!--
      Pre-paint theme resolution (D2, tri-state), guarded because storage can
      throw (e.g. locked-down privacy modes). The server-rendered class is
      dark, so a thrown error keeps the canonical no-JS experience.
    -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'dark') return;
          const prefersLight = window.matchMedia('(prefers-color-scheme: light)').matches;
          if (stored === 'light' || prefersLight) {
            document.documentElement.classList.remove('dark');
          }
        } catch {
          /* Keep the server-rendered dark theme. */
        }
      })();
    </script>
  </head>
  <body>
    <!--
      D6 pinned attributes (plan §3). The element is inert markup until the
      bridge imports the bundled module; `no-font-link` keeps the Michroma
      request self-hosted. z-index: -1 ambient / 2147483000 during the intro.
    -->
    <wormhole-bg
      fixed
      intro="once"
      look="storm"
      lightning="on"
      ambient-opacity="0.4"
      ambient-fps="30"
      no-font-link
      logo-text={LOGO_TEXT}
    ></wormhole-bg>

    <!--
      Measurement skip (plan §4 Phase 6.2): Lighthouse must never measure the
      intro overlay as the LCP element. `?measure=1` (or a pre-seeded
      sessionStorage `wormhole:measure=1`) sets the vendor's documented
      `intro="off"` mode *before* the bridge imports the element, so the real
      intro runs unchanged for every other visitor. Site-level only — the
      vendored copy and its three patches (VENDOR_PATCHES.md) are untouched.
    -->
    <script is:inline>
      (() => {
        try {
          const requested =
            new URLSearchParams(window.location.search).get('measure') === '1' ||
            window.sessionStorage.getItem('wormhole:measure') === '1';
          if (!requested) return;
          document.querySelector('wormhole-bg')?.setAttribute('intro', 'off');
        } catch {
          /* Measurement is opt-in; a failure keeps the pinned intro="once". */
        }
      })();
    </script>

    <!--
      The page shell is made `inert` for the duration of the intro (D10).
      Vendor patch #2 releases it before restoring focus; the bridge also
      releases it on watchdog, theme change and module-import failure.
    -->
    <div id="site-shell" data-wormhole-shell>
      <a
        href="#main"
        class="sr-only rounded-md bg-surface-container px-md py-sm text-on-surface-heading focus:not-sr-only focus:absolute focus:left-sm focus:top-sm focus:z-50"
      >
        Skip to content
      </a>

      <header
        data-pagefind-ignore
        class="sticky top-0 z-40 border-b border-outline-variant bg-surface/85 backdrop-blur-md"
      >
        <div
          class="mx-auto flex w-full max-w-[1256px] items-center justify-between gap-md px-gutter py-sm"
        >
          <a
            href="/"
            class="focus-ring rounded-sm font-display text-label-lg uppercase tracking-[0.02em] text-on-surface-heading"
          >
            Christopher Tapia
          </a>

          <nav aria-label="Primary" class="hidden items-center gap-lg md:flex">
            {NAV_ITEMS.map((item) => (
              <a
                href={item.href}
                aria-current={isActive(item.href) ? 'page' : undefined}
                class:list={[
                  'focus-ring inline-flex min-h-touch-target items-center rounded-sm font-headline text-label-lg uppercase transition-colors',
                  isActive(item.href)
                    ? 'text-on-surface-heading underline decoration-2 underline-offset-4'
                    : 'text-on-surface hover:text-link',
                ]}
              >
                {item.label}
              </a>
            ))}
          </nav>

          <div class="flex items-center gap-sm">
            <div data-sound-slot class="flex flex-col items-end">
              <SoundToggle />
            </div>
            <ThemeToggle />

            <details class="relative md:hidden">
              <summary
                class="focus-ring inline-flex min-h-touch-target cursor-pointer list-none items-center rounded-md border border-outline bg-surface-container px-md font-headline text-label-lg uppercase text-on-surface-heading [&::-webkit-details-marker]:hidden"
              >
                Menu
              </summary>
              <nav
                aria-label="Mobile"
                class="absolute right-0 top-full z-50 mt-sm w-[min(20rem,calc(100vw-2rem))] rounded-md border border-outline bg-surface-container p-md"
              >
                <ul class="flex list-none flex-col">
                  {NAV_ITEMS.map((item) => (
                    <li>
                      <a
                        href={item.href}
                        aria-current={isActive(item.href) ? 'page' : undefined}
                        class:list={[
                          'focus-ring inline-flex min-h-touch-target w-full items-center rounded-sm px-sm font-headline text-label-lg uppercase',
                          isActive(item.href)
                            ? 'text-on-surface-heading underline decoration-2 underline-offset-4'
                            : 'text-on-surface hover:underline',
                        ]}
                      >
                        {item.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </nav>
            </details>
          </div>
        </div>
      </header>

      <slot />

      <footer data-pagefind-ignore class="mt-xxxl border-t border-outline-variant">
        <div
          class="mx-auto flex w-full max-w-[1256px] flex-col gap-md px-gutter py-xl md:flex-row md:items-center md:justify-between"
        >
          <p class="font-body text-body-sm text-on-surface-muted">
            © 2026 Christopher Tapia. Built with Astro.
          </p>
          <nav aria-label="Footer">
            <ul class="flex list-none flex-wrap gap-x-lg gap-y-xs">
              {NAV_ITEMS.map((item) => (
                <li>
                  <a
                    href={item.href}
                    class="focus-ring inline-flex min-h-touch-target items-center rounded-sm font-headline text-label-lg uppercase text-on-surface hover:text-link"
                  >
                    {item.label}
                  </a>
                </li>
              ))}
              <li>
                <a
                  href="/series"
                  class="focus-ring inline-flex min-h-touch-target items-center rounded-sm font-headline text-label-lg uppercase text-on-surface hover:text-link"
                >
                  Series
                </a>
              </li>
              <li>
                <a
                  href="/rss.xml"
                  class="focus-ring inline-flex min-h-touch-target items-center rounded-sm font-headline text-label-lg uppercase text-on-surface hover:text-link"
                >
                  RSS
                </a>
              </li>
            </ul>
          </nav>
        </div>
      </footer>
    </div>

    <script>
      import { startWormholeBridge } from '../lib/wormhole-bridge';
      startWormholeBridge();
    </script>
  </body>
</html>
