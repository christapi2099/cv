---
import { cn } from '../../lib/cn';

/**
 * DESIGN.md `toggle`: full-round, container surface, `label-lg` text.
 * Presentational primitive; the sound and theme toggles own their state
 * machines (Phase 3/4) and pass `pressed`/the visible label here.
 */
type Props = {
  pressed?: boolean;
  id?: string;
  ariaLabel?: string;
  class?: string;
};

const { pressed, id, ariaLabel, class: className } = Astro.props;
---

<button
  id={id}
  type="button"
  aria-pressed={pressed}
  aria-label={ariaLabel}
  class={cn(
    'focus-ring inline-flex h-touch-target items-center justify-center gap-sm whitespace-nowrap rounded-full border border-outline-variant bg-surface-container px-md font-headline text-label-lg uppercase text-on-surface-heading transition-colors hover:bg-surface-elevated',
    className,
  )}
>
  <slot name="icon" />
  <span><slot /></span>
</button>
