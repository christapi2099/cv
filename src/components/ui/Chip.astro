---
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '../../lib/cn';

/**
 * DESIGN.md `chip`, `chip-brand-rolltrack`, `chip-brand-saha`.
 * Visual chips may be shorter than a touch target, but never below 28px;
 * linked chips (the usual case) are full 44px targets.
 */
const chip = cva('inline-flex items-center gap-xs rounded-full px-sm font-body text-label-sm', {
  variants: {
    variant: {
      default: 'bg-primary-container text-on-primary-container',
      rolltrack: 'bg-rolltrack-black text-rolltrack-on-black',
      saha: 'bg-saha-green text-saha-on-green',
    },
  },
  defaultVariants: {
    variant: 'default',
  },
});

type Props = VariantProps<typeof chip> & {
  href?: string;
  class?: string;
};

const { variant = 'default', href, class: className } = Astro.props;
const visualSize = href ? 'min-h-touch-target py-xs' : 'min-h-[28px] py-xs';
---

{
  href ? (
    <a href={href} class={cn(chip({ variant }), visualSize, 'focus-ring', className)}>
      <slot />
    </a>
  ) : (
    <span class={cn(chip({ variant }), visualSize, className)}>
      <slot />
    </span>
  )
}
