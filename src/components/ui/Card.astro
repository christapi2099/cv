---
import { cva, type VariantProps } from 'class-variance-authority';
import { cn } from '../../lib/cn';

/** DESIGN.md `card` / `card-elevated`: tonal depth, never a drop shadow. */
const card = cva('relative rounded-lg border border-outline-variant p-lg shadow-sm dark:shadow-none', {
  variants: {
    variant: {
      default: 'bg-surface-container text-on-surface',
      elevated: 'bg-surface-elevated text-on-surface',
    },
  },
  defaultVariants: {
    variant: 'default',
  },
});

type Props = VariantProps<typeof card> & {
  /** Interactive cards step up to `surface-elevated` on hover/focus. */
  interactive?: boolean;
  id?: string;
  class?: string;
};

const { variant = 'default', interactive = false, id, class: className } = Astro.props;
---

<div
  id={id}
  class={cn(
    card({ variant }),
    interactive &&
      'transition-colors hover:bg-surface-elevated focus-within:bg-surface-elevated hover:border-outline focus-within:border-outline',
    className,
  )}
>
  <slot />
</div>
