---
import { cn } from '../../lib/cn';
import Button from '../ui/Button.astro';
import SectionHeading from '../ui/SectionHeading.astro';

/**
 * Work hub value prop (plan §4 Phase 4.2): a stable fragment id, one proof
 * line, and an internal link into the case study. The id is what the
 * fragment checker validates in the browser.
 */
type Props = {
  id: string;
  title: string;
  proof: string;
  href: string;
  linkLabel?: string;
  class?: string;
};

const { id, title, proof, href, linkLabel = 'Read the case study', class: className } = Astro.props;
---

<section
  id={id}
  aria-labelledby={`${id}-heading`}
  class={cn(
    'flex scroll-mt-xxxl flex-col gap-sm rounded-lg border border-outline-variant bg-surface-container p-lg shadow-sm dark:shadow-none',
    className,
  )}
>
  <div class="h-0.5 w-12 rounded-full bg-primary" aria-hidden="true"></div>
  <SectionHeading level={3} id={`${id}-heading`}>{title}</SectionHeading>
  <p class="max-w-[68ch] font-body text-body-md text-on-surface">{proof}</p>
  <div class="mt-auto pt-sm">
    <Button variant="ghost" href={href} class="-ml-md">{linkLabel}</Button>
  </div>
</section>
