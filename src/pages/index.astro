---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Christopher Tapia — Full-stack engineer"
  description="Christopher Tapia is a full-stack engineer, co-founder & CTO of RollTrackApp, and a freelance developer building Stripe Connect, LiveKit, and performance-critical web software."
>
  <main id="main" class="mx-auto w-full max-w-[1256px] px-gutter py-xxxl">
    <p class="font-headline text-label-lg uppercase text-link">
      Full-stack · Stripe Connect · LiveKit · Performance
    </p>
    <h1 class="mt-lg font-display text-display uppercase text-on-surface-heading">
      Christopher Tapia
    </h1>
    <p class="mt-lg max-w-[68ch] text-body-lg text-on-surface">
      I build production software that makes money, saves money, and holds up under real
      traffic. This site is the long-form proof: case studies with numbers, a blog with
      engineering depth, and the CV behind both.
    </p>
  </main>
</BaseLayout>
